# Credentials for cron/vcard_export.sh - copy to ~/.config/erpnext-client/vcard-export.env, chmod 600.
# ERPNext: API key and secret of a user that may read Leads, Addresses and Users
# (ERPNext: Settings -> My Settings -> API Access).
ERPNEXT_SERVER=https://erpnext.example
ERPNEXT_KEY=...
ERPNEXT_SECRET=...
# Nextcloud: the user owning the address books and an app password (Settings -> Security).
NEXTCLOUD_URL=https://cloud.example
NEXTCLOUD_USER=erpnext
NEXTCLOUD_PASSWORD=...
