# Credentials for cron/mail_quarantine.sh - copy to ~/.config/erpnext-client/mail-quarantine.env, chmod 600.
# The IMAP account that ERPNext pulls leads from (Email Account "Zentraler Email-Eingang").
IMAP_HOST=imap.ionos.de
IMAP_PORT=993
IMAP_USER=erp@bremer-solidarstrom.de
IMAP_PASSWORD=...
# folder for mails with broken embedded images (created if missing)
IMAP_FOLDER=Fehlerhaft
